# ==============================================================================
# Getitresolved — Production & Preview Environment Variables (Vercel)
# ==============================================================================
#
# Environments in Vercel:
# - Production: Live deployment serving citizens and municipal staff.
# - Preview: Ephemeral staging branches & pull request previews.
# - Development: Local developer workstation (runs via npm run dev / npm start).
#
# IMPORTANT: Keep all database credentials, session secrets, storage tokens,
# and AI keys server-side. Never prefix backend secrets with VITE_ or NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Managed PostgreSQL)
# ------------------------------------------------------------------------------
# Provider: Supabase, Neon, AWS RDS with PgBouncer, or any external PostgreSQL 15+.
# NOTE: Use separate databases or separate schemas for Preview and Production!
#
# DATABASE_URL:
#   Pooled connection string (transaction mode / pgbouncer).
#   Used by PrismaClient in serverless functions to prevent connection exhaustion.
#   Belongs in: Production, Preview
DATABASE_URL="postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL:
#   Direct, unpooled connection string (port 5432 session mode).
#   Required by Prisma Migrate (`prisma migrate deploy`) because connection
#   poolers in transaction mode do not support DDL advisory locks.
#   Belongs in: Production, Preview
DIRECT_URL="postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. RUNTIME & APPLICATION HOSTING
# ------------------------------------------------------------------------------
# NODE_ENV: Set to "production" in Vercel.
# Belongs in: Production, Preview
NODE_ENV="production"

# PORT: Optional on Vercel (automatically managed); 5000 for local development.
PORT=5000

# APP_ORIGIN:
#   The canonical public URL of your deployment (used for CORS and cookies).
#   Production example: "https://civicresolve.vercel.app"
#   Belongs in: Production (set to custom domain), Preview (or omit to auto-match Vercel domain)
APP_ORIGIN="https://civicresolve.vercel.app"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION SECURITY
# ------------------------------------------------------------------------------
# JWT_SECRET:
#   Cryptographically secure random string (minimum 32 characters, 64+ recommended).
#   Generate using: openssl rand -base64 48
#   Belongs in: Production, Preview (use DIFFERENT secrets for prod and preview!)
JWT_SECRET="replace-with-a-cryptographically-random-secret-key-at-least-64-characters"

# COOKIE_SECURE:
#   Must be "true" for production HTTPS deployments.
#   Belongs in: Production, Preview
COOKIE_SECURE="true"

# INITIAL_ADMIN_SECRET:
#   A secret token used to authorize the initial administrator setup endpoint
#   (/api/auth/setup-initial-admin) or to configure emergency administrative accounts.
#   Belongs in: Production, Preview
INITIAL_ADMIN_SECRET="replace-with-a-secure-bootstrap-setup-secret"

# ADMIN_EMAIL & ADMIN_PASSWORD (Optional bootstrap):
#   If set during initial migration / deployment, the system automatically
#   creates or updates the production administrator with these credentials.
#   Belongs in: Production
ADMIN_EMAIL="admin@civicresolve.gov"
ADMIN_PASSWORD="replace-with-a-strong-production-admin-password"
ADMIN_NAME="Municipal Administrator"

# ------------------------------------------------------------------------------
# 4. DEMONSTRATION & ACCESS CONTROLS
# ------------------------------------------------------------------------------
# ENABLE_DEMO_ACCOUNTS:
#   Controls whether 1-click demo logins (Elena Rostova, Citizen Jane, Staff accounts)
#   and default known credentials are enabled.
#   - In Production: Set to "false" (strict production security).
#   - In Preview / Testing: Set to "true" (allows team review of roles).
ENABLE_DEMO_ACCOUNTS="false"

# SEED_DEMO_DATA:
#   Controls whether `prisma/seed.ts` seeds fictional complaints and demo users.
#   - In Production: Set to "false" (seeds ONLY essential categories, wards, and routing table).
#   - In Preview: Set to "true" (populates sample complaints for evaluation).
SEED_DEMO_DATA="false"

# ------------------------------------------------------------------------------
# 5. DURABLE OBJECT STORAGE (Photo Uploads: 3 images, 5MB each)
# ------------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN:
#   Provided automatically by Vercel when connecting a Vercel Blob store.
#   Enables durable photo storage and direct client uploads to bypass Vercel's
#   4.5MB Serverless Function payload limit.
#   Acquire via: Vercel Dashboard -> Storage -> Create Blob Store -> Connect to Project.
#   Belongs in: Production, Preview
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# UPLOAD_DIR:
#   Fallback local filesystem directory for attachments (used when BLOB_READ_WRITE_TOKEN is absent).
#   In local development: "/home/runner/workspace/uploads"
#   On Vercel (ephemeral fallback): "/tmp/uploads"
UPLOAD_DIR="/tmp/uploads"

# ------------------------------------------------------------------------------
# 6. AI CLASSIFICATION & DETERMINISTIC FALLBACK
# ------------------------------------------------------------------------------
# AI_PROVIDER:
#   - "fallback": Deterministic municipal keyword and rule engine. Zero external dependencies.
#   - "gemini": Google Gemini API classification.
#   Belongs in: Production, Preview
AI_PROVIDER="fallback"

# GEMINI_API_KEY:
#   Google AI Studio API Key. If missing, empty, or if requests timeout,
#   the system automatically executes transparent deterministic fallback.
#   Acquire via: https://aistudio.google.com/
#   Belongs in: Production, Preview
GEMINI_API_KEY=""

# AI_CONFIDENCE_THRESHOLD:
#   Minimum confidence score (0.0 to 1.0) required to auto-route complaints.
#   Issues with confidence below this threshold divert to the Administrator Review Queue.
#   Default: 0.75
AI_CONFIDENCE_THRESHOLD="0.75"
