{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": [
        "prisma/schema.prisma",
        "node_modules/.prisma/**/*",
        "node_modules/@prisma/client/**/*"
      ]
    },
    "api/*.ts": {
      "includeFiles": [
        "prisma/schema.prisma",
        "node_modules/.prisma/**/*",
        "node_modules/@prisma/client/**/*"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/ready",
      "destination": "/api/ready"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|api$|assets/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
