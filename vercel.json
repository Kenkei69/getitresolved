{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/*.js": {
      "includeFiles": "node_modules/.prisma/client/**"
    },
    "api/**/*.js": {
      "includeFiles": "node_modules/.prisma/client/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|api$|assets/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
